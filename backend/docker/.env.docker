# Backend .env configuration for Docker MongoDB setup
# Copy this file to .env.docker and update the values
# Use this file when running MongoDB via docker-compose
# ===== DOCKER MONGODB CONFIGURATION =====
# These variables are used by docker-compose.yml
MONGO_USER=<set-mongo-admin-user>
MONGO_PASSWORD=<set-mongo-strong-password>
MONGO_INITDB_DATABASE=a-ir-dd2-dev
MONGO_HOST=localhost
MONGO_PORT=27017
# ===== SERVER CONFIGURATION =====
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:4000

# ===== DATABASE CONFIGURATION (MongoDB via Docker) =====
# Connection string for Docker MongoDB container
# Keep this URI aligned with MONGO_USER and MONGO_PASSWORD above.
# Database: a-ir-dd2-dev
MONGODB_URI=mongodb://<set-mongo-admin-user>:<set-mongo-strong-password>@localhost:27017/a-ir-dd2-dev?authSource=admin

# ===== SECURITY CONFIGURATION (CRITICAL - J4.3) =====
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_32_chars_hex_here

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_encryption_key_64_hex_chars_here

JWT_EXPIRY=3600000

# ===== LOGGING & DEBUG =====
LOG_LEVEL=debug

# ===== SANDBOX CONFIGURATION (J0/J4.3) =====
# Base workspace directory for user Python function files
WORKSPACE_ROOT=./python/users
# Maximum execution time per sandbox run (ms)
FUNCTION_SANDBOX_TIMEOUT_MS=15000
# Maximum RAM per TypeScript sandbox (MB, isolated-vm)
FUNCTION_SANDBOX_RAM_MB=256
# Docker image tag for the Python sandbox service
SANDBOX_PYTHON_IMAGE=app-sandbox-python:3.12
# ===== RUNTIME HEALTH & IMAGES (J6) =====
RUNTIME_DOCKER_EXECUTABLE=docker
RUNTIME_NODE_EXECUTABLE=node
RUNTIME_PYTHON_EXECUTABLES=python3,python
RUNTIME_NODE_IMAGE=airdd2-runtime-node:22.22.2-ubuntu-noble
RUNTIME_PYTHON_IMAGE=airdd2-runtime-python:3.12-ubuntu-noble
RUNTIME_PYTHON_PROVISIONING_IMAGE=airdd2-python-provisioning:3.12-ubuntu-noble
RUNTIME_PROBE_TIMEOUT_MS=8000
# Maximum code file size (KB)
FUNCTION_MAX_CODE_SIZE_KB=100
# Maximum number of pip dependencies per function
FUNCTION_MAX_DEPS_COUNT=20
