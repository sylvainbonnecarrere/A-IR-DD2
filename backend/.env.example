# Copy this file to backend/.env before running the app locally.
# MongoDB remains the source of truth; Redis is intentionally not required.

MONGO_USER=admin
MONGO_PASSWORD=change-me-strong-password
MONGO_INITDB_DATABASE=a-ir-dd2-dev
MONGODB_URI=mongodb://admin:change-me-strong-password@localhost:27017/a-ir-dd2-dev?authSource=admin

JWT_SECRET=replace-with-a-random-jwt-secret
REFRESH_TOKEN_SECRET=replace-with-a-random-refresh-secret
ENCRYPTION_KEY=replace-with-32-byte-key
JWT_EXPIRATION=1h

# Optional: local runtime tuning
# NODE_ENV=development
# PORT=3001
# RUNTIME_NATIVE_PYTHON_PROVISION_ON_STARTUP=true
