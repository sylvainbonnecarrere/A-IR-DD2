# /etc/airdd2/backend.env — root-owned, mode 0640 (root:airdd2-backend). Never commit real values.
NODE_ENV=production
MONGODB_URI=mongodb://127.0.0.1:27017/a-ir-dd2
# Required secrets (generate with: node -p "require('crypto').randomBytes(32).toString('hex')")
JWT_SECRET=
REFRESH_TOKEN_SECRET=
ENCRYPTION_KEY=
DOCKER_GATEWAY_REQUIRED=true
DOCKER_GATEWAY_SOCKET=/run/airdd2-docker-gateway/docker.sock
WORKSPACE_STORAGE_PATH=/opt/airdd2/backend/storage/workspaces
# Runtime images must match the gateway env file (the gateway allowlists them independently).
RUNTIME_NODE_IMAGE=airdd2-runtime-node:24.19.0-ubuntu-noble
RUNTIME_PYTHON_IMAGE=airdd2-runtime-python:3.12-ubuntu-noble
RUNTIME_PYTHON_PROVISIONING_IMAGE=airdd2-python-provisioning:3.12-ubuntu-noble
