{
  "name": "llm-agent-workflow-backend",
  "version": "1.0.0",
  "description": "Backend service for executing Python tools for the LLM Agent Workflow Orchestrator.",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only -r  dotenv/config src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "runtime:setup": "node scripts/runtime/setup-runtime.cjs",
    "runtime:check": "node scripts/runtime/check-runtime.cjs",
    "runtime:update-digests": "node scripts/runtime/sync-runtime-base-digests.cjs",
    "runtime:rebuild": "node scripts/runtime/rebuild-runtime.cjs",
    "runtime:verify:provisioning": "node scripts/runtime/verify-provisioning-runtime.cjs",
    "runtime:ci": "npm run runtime:rebuild && npm run runtime:verify:provisioning",
    "runtime:scan": "node scripts/runtime/scan-runtime.cjs --fail-on-severity=high",
    "runtime:maintain": "node scripts/runtime/maintain-runtime.cjs --fail-on-severity=high",
    "migrate:up": "ts-node -r dotenv/config src/migrations/004_tools_v2_function_registry.ts up",
    "migrate:down": "ts-node -r dotenv/config src/migrations/004_tools_v2_function_registry.ts down",
    "seed:functions": "ts-node -r dotenv/config src/seeds/nativeFunctions.seed.ts",
    "setup:tools-v2": "npm run migrate:up && npm run seed:functions && echo 'Tools V2 setup terminé'"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "socket.io": "^4.7.5",
    "zod": "^3.22.4"
  },
  "optionalDependencies": {
    "isolated-vm": "^4.7.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.26",
    "@types/passport": "^1.0.16",
    "@types/passport-jwt": "^4.0.0",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
