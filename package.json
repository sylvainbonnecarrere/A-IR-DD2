{
  "name": "llm-agent-workflow-orchestrator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:web-search-py": "cd backend && npx jest src/__tests__/user-tool-legacy-mapper.test.ts src/__tests__/user-tool-startup-sync.service.test.ts src/__tests__/native-python-provisioning.service.test.ts src/__tests__/build.service.test.ts src/__tests__/web-search-py-native.test.ts src/__tests__/web-search-py-wrapper-compat.test.ts src/__tests__/web-search-py-pipeline-components.test.ts --runInBand && cd .. && npx jest tests/services/AgentLoop.test.ts tests/components/V2AgentNode.agentloop.test.tsx --runInBand",
    "ci:web-search-py-runtime": "npm run test:web-search-py && cd backend && npm run runtime:ci",
    "test:j7:editor:semi-e2e": "playwright test tests/fonctionnels/J7.Editor.RealBrowser.semi-e2e.spec.ts",
    "test:smoke:live": "playwright test -c playwright.live.config.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:settingsmodal:report": "node scripts/run-jest-report.mjs tests/unitaires/SettingsModal.TNR.test.ts --outputDir tests/temp_rapport_tests/unitaires/settingsmodal --reportBase settingsmodal-jest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.893.0",
    "@aws-sdk/s3-request-presigner": "^3.893.0",
    "@google-cloud/storage": "^7.19.0",
    "@google/genai": "^1.19.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "axios": "^1.13.2",
    "child_process": "^1.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "monaco-editor": "^0.55.1",
    "path": "^0.12.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "reactflow": "^11.11.4",
    "socket.io-client": "^4.7.5",
    "url": "^0.11.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
