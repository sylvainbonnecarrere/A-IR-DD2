{
  "name": "llm-agent-workflow-orchestrator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=25.9.0 <26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "ci:node25:runtime": "node scripts/ci/verify-node25-runtime.mjs",
    "test": "jest",
    "test:integration:hydration": "jest tests/fonctionnels/App.workspaceHydration.integration.test.tsx --runInBand",
    "test:components:ci": "jest tests/components --runInBand",
    "test:canvas:non-regression": "jest tests/components/WorkflowCanvas.render.test.tsx tests/components/WorkflowCanvas.drag-collision.test.tsx tests/components/WorkflowCanvas.minimize-restore.test.tsx --runInBand",
    "test:web-search-py": "cd backend && npx jest src/__tests__/user-tool-legacy-mapper.test.ts src/__tests__/database-init.seeding.test.ts src/__tests__/user-functions-eol-migration.test.ts src/__tests__/native-python-provisioning.service.test.ts src/__tests__/build.service.test.ts src/__tests__/web-search-py-native.test.ts src/__tests__/web-search-py-wrapper-compat.test.ts src/__tests__/web-search-py-pipeline-components.test.ts --runInBand && cd .. && npx jest tests/services/AgentLoop.test.ts tests/components/V2AgentNode.agentloop.test.tsx --runInBand",
    "ci:web-search-py-runtime": "npm run test:web-search-py && cd backend && npm run runtime:ci",
    "test:j7:editor:semi-e2e": "playwright test tests/fonctionnels/J7.Editor.RealBrowser.semi-e2e.spec.ts",
    "test:smoke:live": "playwright test -c playwright.live.config.ts",
    "node25:prepare": "node scripts/prepare-node25-validation.mjs 25.9.0",
    "audit:root": "npm audit",
    "audit:backend": "npm --prefix backend audit",
    "audit:all": "npm run audit:root && npm run audit:backend",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:settingsmodal:report": "node scripts/run-jest-report.mjs tests/unitaires/SettingsModal.TNR.test.ts --outputDir tests/temp_rapport_tests/unitaires/settingsmodal --reportBase settingsmodal-jest"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.90.12",
    "axios": "^1.16.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "reactflow": "^11.11.4",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "axios-mock-adapter": "^2.1.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.9",
    "typescript": "^5.7.3",
    "vite": "^8.2.2"
  },
  "overrides": {
    "brace-expansion@1.1.12": "1.1.18",
    "dompurify": "3.4.12",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.4"
    },
    "picomatch@2.3.1": "2.3.2",
    "picomatch@4.0.3": "4.0.4",
    "socket.io-parser": "^4.2.7"
  }
}
